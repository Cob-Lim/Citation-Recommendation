def rerank_chunks(chunks, query):
    query_keywords = {
        "restaurants": ["restaurant", "restaurants", "CRP", "Chinese Restaurant Process", "table", "tables", "customer", "customers", "dish", "dishes", "segment", "segments", "restaurant(s)", "table indicator"],
        "parallelised_tcm": ["parallel", "parallelised", "processor", "processors", "distributed", "MCMC", "Gibbs sampling", "inference", "algorithm", "sampler", "sampling", "model", "topic model", "topic modeling", "topic models", "PLTM", "LDA", "TSM", "hierarchical", "Pitman-Yor", "Dirichlet Process", "Bayesian", "non-parametric", "collapsed Gibbs sampler", "block Gibbs sampler", "Markov chain Monte Carlo"],
        "merging_cr": ["merge", "merging", "split-merge", "merging restaurant", "split/merge", "merging restaurant(s)", "split/merging restaurant(s)", "merging table", "split/merging table(s)", "merging tables", "split/merge tables", "split s m into s r and s l", "merge s r and s l to one segment s m"],
        "topics": ["topic", "topics", "topic assignments", "topic boundaries", "topic distribution", "topic space", "topic model", "topic modeling", "topic models", "topic-specific", "topic trends", "topic prevalence", "topic alignment", "topic co-occurrence", "topic transfer", "topic index", "topic mixture", "topic correspondence", "topic cache", "topic words", "topicexist", "latent topic", "topic granularity"]
    }

    concept_weights = {
        "restaurants": 3,
        "parallelised_tcm": 3,
        "merging_cr": 4,
        "topics": 2
    }

    chunk_scores = []
    for i, chunk in enumerate(chunks):
        score = 0
        chunk_lower = chunk.lower()
        for concept, keywords in query_keywords.items():
            concept_score = 0
            for keyword in keywords:
                concept_score += chunk_lower.count(keyword.lower())
            score += concept_score * concept_weights[concept]
        chunk_scores.append((score, i))

    ranked_chunks_indices = [original_index for score, original_index in sorted(chunk_scores, key=lambda item: item[0], reverse=True)]
    return ranked_chunks_indices

